diff --git a/src/rl/buffer.py b/src/rl/buffer.py
new file mode 100644
index 0000000..20c07e7
--- /dev/null
+++ b/src/rl/buffer.py
@@ -0,0 +1,86 @@
+"""Rollout storage and generalized advantage estimation (GAE)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import torch
+
+from rl.networks import NetworkSpec
+
+
+@dataclass
+class Batch:
+    """Flattened training samples (N = T * E * A), all torch tensors on one device."""
+
+    grid: torch.Tensor
+    vec: torch.Tensor
+    mask: torch.Tensor
+    role_index: torch.Tensor
+    actions: torch.Tensor
+    old_log_probs: torch.Tensor
+    advantages: torch.Tensor
+    returns: torch.Tensor  # raw (unnormalized) scale
+    old_values: torch.Tensor  # raw scale
+    alive: torch.Tensor  # float 0/1
+    critic_grid: torch.Tensor
+    critic_vec: torch.Tensor
+
+    def __len__(self) -> int:
+        return int(self.actions.shape[0])
+
+
+class RolloutBuffer:
+    def __init__(self, steps: int, envs: int, agents: int, spec: NetworkSpec) -> None:
+        T, E, A = steps, envs, agents
+        self.T, self.E, self.A = T, E, A
+        h, w = spec.height, spec.width
+        f32 = np.float32
+        self.grid = np.zeros((T, E, A, spec.actor_channels, h, w), f32)
+        self.vec = np.zeros((T, E, A, spec.actor_vec_dim), f32)
+        self.mask = np.zeros((T, E, A, spec.num_actions), bool)
+        self.alive = np.zeros((T, E, A), f32)
+        self.role_index = np.zeros((T, E, A), np.int64)
+        self.critic_grid = np.zeros((T, E, A, spec.critic_channels, h, w), f32)
+        self.critic_vec = np.zeros((T, E, A, spec.critic_vec_dim), f32)
+        self.actions = np.zeros((T, E, A), np.int64)
+        self.log_probs = np.zeros((T, E, A), f32)
+        self.values = np.zeros((T + 1, E, A), np.float64)  # raw scale; [T] is the bootstrap
+        self.rewards = np.zeros((T, E, A), np.float64)
+        self.dones = np.zeros((T, E), np.float64)  # episode ended after this step
+        self.advantages = np.zeros((T, E, A), np.float64)
+        self.returns = np.zeros((T, E, A), np.float64)
+
+    def compute_gae(self, gamma: float, lam: float) -> None:
+        """Fill advantages/returns. ``values[T]`` must hold the bootstrap value."""
+        last = np.zeros((self.E, self.A))
+        for t in reversed(range(self.T)):
+            nonterminal = (1.0 - self.dones[t])[:, None]
+            delta = self.rewards[t] + gamma * self.values[t + 1] * nonterminal - self.values[t]
+            last = delta + gamma * lam * nonterminal * last
+            self.advantages[t] = last
+        self.returns = self.advantages + self.values[: self.T]
+
+    def to_batch(self, device: torch.device) -> Batch:
+        def flat(x: np.ndarray) -> np.ndarray:
+            return x.reshape(self.T * self.E * self.A, *x.shape[3:])
+
+        def t(x: np.ndarray, dtype: torch.dtype | None = None) -> torch.Tensor:
+            out = torch.from_numpy(np.ascontiguousarray(flat(x)))
+            return out.to(device=device, dtype=dtype) if dtype else out.to(device)
+
+        return Batch(
+            grid=t(self.grid),
+            vec=t(self.vec),
+            mask=t(self.mask),
+            role_index=t(self.role_index),
+            actions=t(self.actions),
+            old_log_probs=t(self.log_probs),
+            advantages=t(self.advantages, torch.float32),
+            returns=t(self.returns, torch.float32),
+            old_values=t(self.values[: self.T], torch.float32),
+            alive=t(self.alive),
+            critic_grid=t(self.critic_grid),
+            critic_vec=t(self.critic_vec),
+        )
diff --git a/src/rl/canonical.py b/src/rl/canonical.py
new file mode 100644
index 0000000..e04c506
--- /dev/null
+++ b/src/rl/canonical.py
@@ -0,0 +1,54 @@
+"""Team-relative ("canonical") view of the board.
+
+With mirroring on, BLUE sees the grid flipped left-right so every agent sees its own
+base on the left. One policy can then play both sides, and training data doubles.
+Network outputs are mapped back to environment actions here.
+"""
+
+from __future__ import annotations
+
+from ctf.actions import Action
+from ctf.agent import Team
+from ctf.config import CTFConfig
+from rl.schema import ConfigError
+
+#: index of each action in the network's output layer
+ACTIONS: tuple[Action, ...] = tuple(Action)
+ACTION_INDEX: dict[Action, int] = {a: i for i, a in enumerate(ACTIONS)}
+NUM_ACTIONS = len(ACTIONS)
+_LEFT, _RIGHT = ACTION_INDEX[Action.LEFT], ACTION_INDEX[Action.RIGHT]
+
+
+def assert_mirror_symmetric(config: CTFConfig) -> None:
+    """Mirroring BLUE is only valid if the map is left-right symmetric."""
+    w = config.width
+    mirrored_obstacles = {(w - 1 - x, y) for x, y in config.obstacles}
+    mirrored_base = (w - 1 - config.red_base[0], config.red_base[1])
+    if mirrored_obstacles != set(config.obstacles) or mirrored_base != tuple(config.blue_base):
+        raise ConfigError(
+            "features.mirror_blue=true needs a left-right symmetric map "
+            "(mirrored obstacles and bases must coincide); set mirror_blue: false otherwise"
+        )
+
+
+class Canonicalizer:
+    def __init__(self, width: int, team: Team, mirror: bool) -> None:
+        self.width = width
+        self.team = team
+        self.flip = mirror and team is Team.BLUE
+        #: constant fed to the network so it can tell sides apart when NOT mirroring
+        self.team_flag = 0.0 if mirror else (1.0 if team is Team.BLUE else 0.0)
+
+    def cell(self, x: int, y: int) -> tuple[int, int]:
+        return (self.width - 1 - x, y) if self.flip else (x, y)
+
+    def to_env_action(self, index: int) -> Action:
+        if self.flip and index in (_LEFT, _RIGHT):
+            index = _RIGHT if index == _LEFT else _LEFT
+        return ACTIONS[index]
+
+    def mask_to_canonical(self, env_mask: list[bool]) -> list[bool]:
+        out = list(env_mask)
+        if self.flip:
+            out[_LEFT], out[_RIGHT] = out[_RIGHT], out[_LEFT]
+        return out
diff --git a/src/rl/config.py b/src/rl/config.py
new file mode 100644
index 0000000..bed0310
--- /dev/null
+++ b/src/rl/config.py
@@ -0,0 +1,227 @@
+"""RL experiment configuration.
+
+The YAML file is the single source of truth: every field below is required, so no
+hyperparameter is ever hidden in code. Load with :func:`load_rl_config`, which also
+accepts dotted overrides (``{"ppo.learning_rate": 1e-4}``) that go through the same
+strict validation.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+from pathlib import Path
+from typing import Any
+
+from ctf.config import CTFConfig, config_from_dict, config_to_dict, load_config
+from rl.schema import ConfigError, apply_overrides, from_dict, read_yaml
+from strategies.roles import Role
+
+
+class LearnerSide(str, Enum):
+    RED = "red"
+    BLUE = "blue"
+    RANDOM = "random"
+
+
+@dataclass(frozen=True)
+class RunConfig:
+    name: str
+    output_dir: str
+    seed: int
+    device: str  # "cpu", "cuda", "mps" or "auto"
+    torch_threads: int
+    checkpoint_every_steps: int
+    log_every_updates: int
+
+
+@dataclass(frozen=True)
+class EnvSection:
+    config_path: str  # base environment YAML (see configs/default.yaml)
+
+
+@dataclass(frozen=True)
+class RolesConfig:
+    slots: list[Role]  # role of each team slot, in sorted agent-id order
+
+
+@dataclass(frozen=True)
+class FeaturesConfig:
+    mirror_blue: bool  # flip the grid for BLUE so every agent sees "my base on the left"
+    staleness_horizon: int  # steps after which a seen cell counts as fully stale
+
+
+@dataclass(frozen=True)
+class RewardsConfig:
+    win: float
+    loss: float
+    timeout: float
+    pickup: float
+    tagged_while_carrying: float
+    tag_enemy_carrier: float
+    tag_team_share: float
+    attacker_potential: float  # reward per cell of path distance saved
+    defender_potential: float
+    scout_new_cell: float
+    scout_anneal_steps: int  # scout bonus decays linearly to 0 over this many steps
+    step_penalty: float
+
+
+@dataclass(frozen=True)
+class ModelConfig:
+    conv_channels: list[int]
+    kernel_size: int
+    hidden_size: int
+
+
+@dataclass(frozen=True)
+class PPOConfig:
+    learning_rate: float
+    learning_rate_final: float
+    gamma: float
+    gae_lambda: float
+    clip_epsilon: float
+    entropy_coef: float
+    entropy_coef_final: float
+    value_coef: float
+    max_grad_norm: float
+    epochs: int
+    num_minibatches: int
+    adam_eps: float
+    normalize_advantages: bool
+    value_normalization: bool
+
+
+@dataclass(frozen=True)
+class RolloutConfig:
+    num_envs: int
+    num_workers: int
+    rollout_length: int
+    total_steps: int
+
+
+@dataclass(frozen=True)
+class OpponentSpec:
+    kind: str
+    weight: float
+    params: dict[str, Any]
+
+
+@dataclass(frozen=True)
+class PhaseConfig:
+    name: str
+    max_steps: int
+    advance_win_rate: float
+    window_episodes: int
+    fixed_spawn_fraction: float  # share of episodes that use the default (fixed) spawns
+    env_overrides: dict[str, Any]  # CTFConfig keys applied on top of the base env config
+    opponent_noise: float  # probability that an opponent action is replaced by a random one
+    opponents: list[OpponentSpec]
+
+
+@dataclass(frozen=True)
+class CurriculumConfig:
+    learner_side: LearnerSide
+    phases: list[PhaseConfig]
+
+
+@dataclass(frozen=True)
+class RLConfig:
+    run: RunConfig
+    env: EnvSection
+    roles: RolesConfig
+    features: FeaturesConfig
+    rewards: RewardsConfig
+    model: ModelConfig
+    ppo: PPOConfig
+    rollout: RolloutConfig
+    curriculum: CurriculumConfig
+
+    def __post_init__(self) -> None:
+        _validate(self)
+
+
+def _check(condition: bool, message: str) -> None:
+    if not condition:
+        raise ConfigError(message)
+
+
+def _validate(cfg: RLConfig) -> None:
+    p, r = cfg.ppo, cfg.rollout
+    _check(0.0 < p.gamma <= 1.0, "ppo.gamma must be in (0, 1]")
+    _check(0.0 <= p.gae_lambda <= 1.0, "ppo.gae_lambda must be in [0, 1]")
+    _check(p.clip_epsilon > 0, "ppo.clip_epsilon must be > 0")
+    _check(p.epochs >= 1 and p.num_minibatches >= 1, "ppo.epochs/num_minibatches must be >= 1")
+    _check(p.learning_rate > 0 and p.learning_rate_final >= 0, "learning rates must be positive")
+    _check(r.num_envs >= 1 and r.rollout_length >= 1 and r.total_steps >= 1, "rollout sizes must be >= 1")
+    _check(1 <= r.num_workers <= r.num_envs, "rollout.num_workers must be in [1, num_envs]")
+    _check(len(cfg.model.conv_channels) >= 1, "model.conv_channels needs at least one layer")
+    _check(cfg.model.kernel_size % 2 == 1, "model.kernel_size must be odd")
+    _check(cfg.features.staleness_horizon >= 1, "features.staleness_horizon must be >= 1")
+    _check(len(cfg.roles.slots) >= 1, "roles.slots must not be empty")
+    _check(cfg.rewards.scout_anneal_steps >= 1, "rewards.scout_anneal_steps must be >= 1")
+
+    phases = cfg.curriculum.phases
+    _check(len(phases) >= 1, "curriculum.phases must not be empty")
+    for i, ph in enumerate(phases):
+        loc = f"curriculum.phases[{i}] ({ph.name})"
+        _check(ph.max_steps >= 1, f"{loc}: max_steps must be >= 1")
+        _check(0.0 <= ph.advance_win_rate <= 1.0, f"{loc}: advance_win_rate must be in [0, 1]")
+        _check(ph.window_episodes >= 1, f"{loc}: window_episodes must be >= 1")
+        _check(0.0 <= ph.fixed_spawn_fraction <= 1.0, f"{loc}: fixed_spawn_fraction must be in [0, 1]")
+        _check(0.0 <= ph.opponent_noise <= 1.0, f"{loc}: opponent_noise must be in [0, 1]")
+        _check(len(ph.opponents) >= 1, f"{loc}: needs at least one opponent")
+        _check(all(o.weight > 0 for o in ph.opponents), f"{loc}: opponent weights must be > 0")
+    capped = sum(ph.max_steps for ph in phases[:-1])
+    _check(capped < r.total_steps, "phase max_steps (excluding the last phase) must be < rollout.total_steps")
+
+
+def load_base_env_config(cfg: RLConfig, root: Path | None = None) -> CTFConfig:
+    """Load the base environment config; relative paths resolve against ``root`` (default: cwd)."""
+    path = Path(cfg.env.config_path)
+    if not path.is_absolute() and root is not None:
+        path = root / path
+    env_cfg = load_config(path)
+    _check(
+        len(cfg.roles.slots) == env_cfg.agents_per_team,
+        f"roles.slots has {len(cfg.roles.slots)} entries but the env has "
+        f"{env_cfg.agents_per_team} agents per team",
+    )
+    return env_cfg
+
+
+def phase_env_config(base: CTFConfig, phase: PhaseConfig, *, fixed_spawns: bool) -> CTFConfig:
+    """Base env config with the phase's overrides; ``fixed_spawns`` forces spawn_mode=fixed."""
+    merged = {**config_to_dict(base), **phase.env_overrides}
+    if fixed_spawns:
+        merged["spawn_mode"] = "fixed"
+    try:
+        return config_from_dict(merged)
+    except ValueError as exc:
+        raise ConfigError(f"phase {phase.name!r} env_overrides invalid: {exc}") from exc
+
+
+def load_rl_config(path: str | Path, overrides: dict[str, Any] | None = None) -> RLConfig:
+    data = read_yaml(path)
+    if overrides:
+        data = apply_overrides(data, overrides)
+    return from_dict(RLConfig, data)
+
+
+def config_to_plain(cfg: RLConfig) -> dict[str, Any]:
+    from rl.schema import to_dict
+
+    return to_dict(cfg)
+
+
+__all__ = [
+    "ConfigError",
+    "LearnerSide",
+    "RLConfig",
+    "PhaseConfig",
+    "OpponentSpec",
+    "load_rl_config",
+    "load_base_env_config",
+    "phase_env_config",
+    "config_to_plain",
+]
diff --git a/src/rl/env_wrapper.py b/src/rl/env_wrapper.py
new file mode 100644
index 0000000..3d1698e
--- /dev/null
+++ b/src/rl/env_wrapper.py
@@ -0,0 +1,211 @@
+"""Single-environment training wrapper.
+
+Owns one CTFEnvironment per spawn style, one opponent per episode (fresh every time, so
+no state leaks between episodes), the learner's features and rewards, and per-episode
+statistics. Phase changes (curriculum) take effect at the next ``reset()``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from random import Random
+
+import numpy as np
+
+from ctf.actions import Action
+from ctf.agent import Team
+from ctf.config import CTFConfig
+from ctf.environment import CTFEnvironment
+from ctf.observations import ObservationMode
+from rl.config import LearnerSide, PhaseConfig, RLConfig, phase_env_config
+from rl.features import ActorFeatures, CriticFeatures, FeatureBuilder
+from rl.navigation import GridNav
+from rl.opponents import build_opponent
+from rl.rewards import COMPONENTS, RewardCalculator
+from strategies import BaseStrategy
+
+
+@dataclass(frozen=True)
+class EnvStep:
+    actor: ActorFeatures
+    critic: CriticFeatures
+    rewards: np.ndarray  # (A,)
+    done: bool
+    info: dict  # empty until the episode ends, then the episode summary
+
+
+@dataclass
+class _PhaseRuntime:
+    phase: PhaseConfig
+    envs: dict[bool, CTFEnvironment]  # keyed by "uses fixed spawns"
+    builders: dict[Team, FeatureBuilder]
+    rewards: dict[Team, RewardCalculator]
+    env_config: CTFConfig
+
+
+class CTFTrainEnv:
+    def __init__(self, cfg: RLConfig, base_env_config: CTFConfig, seed: int) -> None:
+        self.cfg = cfg
+        self.base_env_config = base_env_config
+        self._rng = Random(seed)
+        self._runtime: _PhaseRuntime | None = None
+        self._pending_phase = 0
+        self._scout_scale = 1.0
+        # per-episode state
+        self._env: CTFEnvironment | None = None
+        self._team = Team.RED
+        self._opponent: BaseStrategy | None = None
+        self._opponent_kind = ""
+        self._fixed_spawns = False
+        self._prev_agents: dict = {}
+        self._stats: dict = {}
+        self.num_agents = base_env_config.agents_per_team
+        self._build_runtime(0)
+
+    # ------------------------------------------------------------------- phases
+
+    def set_phase(self, index: int) -> None:
+        """Switch curriculum phase; applied at the next ``reset()``."""
+        if not 0 <= index < len(self.cfg.curriculum.phases):
+            raise IndexError(f"phase index {index} out of range")
+        self._pending_phase = index
+
+    def set_scout_scale(self, scale: float) -> None:
+        self._scout_scale = float(scale)
+
+    @property
+    def phase_index(self) -> int:
+        assert self._runtime is not None
+        return self.cfg.curriculum.phases.index(self._runtime.phase)
+
+    def _build_runtime(self, index: int) -> None:
+        phase = self.cfg.curriculum.phases[index]
+        envs: dict[bool, CTFEnvironment] = {}
+        env_config = phase_env_config(self.base_env_config, phase, fixed_spawns=False)
+        for fixed in (True, False):
+            conf = phase_env_config(self.base_env_config, phase, fixed_spawns=fixed)
+            conf.seed = self._rng.randrange(2**31)
+            envs[fixed] = CTFEnvironment(conf)
+        traversable = [
+            [(x, y) not in set(env_config.obstacles) for x in range(env_config.width)]
+            for y in range(env_config.height)
+        ]
+        nav = GridNav(traversable)
+        roles = list(self.cfg.roles.slots)
+        builders = {
+            t: FeatureBuilder(env_config, t, roles, self.cfg.features) for t in Team
+        }
+        reward_calcs = {
+            t: RewardCalculator(env_config, t, roles, self.cfg.rewards, self.cfg.ppo.gamma, nav)
+            for t in Team
+        }
+        self._runtime = _PhaseRuntime(phase, envs, builders, reward_calcs, env_config)
+
+    # ------------------------------------------------------------------ episodes
+
+    def _choose_team(self) -> Team:
+        side = self.cfg.curriculum.learner_side
+        if side is LearnerSide.RED:
+            return Team.RED
+        if side is LearnerSide.BLUE:
+            return Team.BLUE
+        return self._rng.choice([Team.RED, Team.BLUE])
+
+    def _choose_opponent(self, phase: PhaseConfig, env_config: CTFConfig) -> tuple[BaseStrategy, str]:
+        weights = [o.weight for o in phase.opponents]
+        spec = self._rng.choices(phase.opponents, weights=weights, k=1)[0]
+        return build_opponent(spec, env_config, Random(self._rng.randrange(2**31))), spec.kind
+
+    def reset(self) -> EnvStep:
+        if self._runtime is None or self.cfg.curriculum.phases[self._pending_phase] is not self._runtime.phase:
+            self._build_runtime(self._pending_phase)
+        rt = self._runtime
+        assert rt is not None
+        phase = rt.phase
+        self._fixed_spawns = self._rng.random() < phase.fixed_spawn_fraction
+        self._env = rt.envs[self._fixed_spawns]
+        self._team = self._choose_team()
+        self._opponent, self._opponent_kind = self._choose_opponent(phase, rt.env_config)
+        self._opponent.reset()
+
+        self._env.reset()
+        builder = rt.builders[self._team]
+        builder.reset()
+        glob = self._env.observe(ObservationMode.GLOBAL)
+        rt.rewards[self._team].reset(glob)
+        self._prev_agents = dict(glob.agents)
+        self._stats = {
+            "returns": np.zeros(self.num_agents),
+            "components": {name: np.zeros(self.num_agents) for name in COMPONENTS},
+            "pickups": 0,
+            "tags_inflicted": 0,
+            "tags_suffered": 0,
+            "length": 0,
+        }
+        actor = builder.actor_features(self._env.observe(ObservationMode.PARTIAL, team=self._team))
+        critic = builder.critic_features(glob)
+        return EnvStep(actor, critic, np.zeros(self.num_agents), False, {})
+
+    def step(self, actions: np.ndarray) -> EnvStep:
+        rt, env = self._runtime, self._env
+        assert rt is not None and env is not None and self._opponent is not None
+        team, opp_team = self._team, self._team.opponent
+        builder = rt.builders[team]
+
+        mine: dict[str, Action] = {}
+        for slot, agent_id in enumerate(builder.agent_ids):
+            if self._prev_agents[agent_id].active:
+                mine[agent_id] = builder.canon.to_env_action(int(actions[slot]))
+
+        opp_obs = env.observe(ObservationMode.PARTIAL, team=opp_team)
+        theirs = self._opponent.act(opp_obs, opp_team)
+        noise = rt.phase.opponent_noise
+        if noise > 0:
+            all_actions = list(Action)
+            theirs = {
+                aid: (self._rng.choice(all_actions) if self._rng.random() < noise else act)
+                for aid, act in theirs.items()
+            }
+
+        _, _, done, info = env.step({**mine, **theirs})
+        glob = env.observe(ObservationMode.GLOBAL)
+        result = rt.rewards[team].step(glob, self._prev_agents, info.get("events", []), self._scout_scale)
+        self._prev_agents = dict(glob.agents)
+
+        self._stats["returns"] += result.total
+        for name, values in result.components.items():
+            self._stats["components"][name] += values
+        self._stats["length"] += 1
+        for event in info.get("events", []):
+            if event.get("type") == "flag_pickup" and event["agent_id"] in builder.agent_ids:
+                self._stats["pickups"] += 1
+            elif event.get("type") == "tag":
+                if event["agent_id"] in builder.agent_ids:
+                    self._stats["tags_suffered"] += 1
+                if event["by_agent_id"] in builder.agent_ids:
+                    self._stats["tags_inflicted"] += 1
+
+        actor = builder.actor_features(env.observe(ObservationMode.PARTIAL, team=team))
+        critic = builder.critic_features(glob)
+        return EnvStep(actor, critic, result.total, bool(done), self._summary(glob) if done else {})
+
+    def _summary(self, glob) -> dict:
+        if glob.winner is self._team:
+            outcome = "win"
+        elif glob.winner is None:
+            outcome = "draw"
+        else:
+            outcome = "loss"
+        return {
+            "outcome": outcome,
+            "length": self._stats["length"],
+            "learner_team": self._team.value,
+            "opponent": self._opponent_kind,
+            "phase": self._runtime.phase.name,  # type: ignore[union-attr]
+            "fixed_spawns": self._fixed_spawns,
+            "pickups": self._stats["pickups"],
+            "tags_inflicted": self._stats["tags_inflicted"],
+            "tags_suffered": self._stats["tags_suffered"],
+            "return": self._stats["returns"].tolist(),
+            "components": {k: v.tolist() for k, v in self._stats["components"].items()},
+        }
