new file mode 100644
index 0000000..f9dbb1e
--- /dev/null
+++ b/src/strategies/llm_commander/controller.py
@@ -0,0 +1,102 @@
+"""Low-level controller: turns orders into the game's UP/DOWN/LEFT/RIGHT/STAY actions.
+
+TODO(5): mixed teams. This is the only place that turns orders into moves. To combine the LLM
+with Team 1's behaviour trees or Team 2's learned policies, write a class with the same methods
+(set_orders, update, report, purge_finished, actions) that forwards each order to their agents.
+"""
+from __future__ import annotations
+
+from ctf.actions import Action
+
+from .commands import DEFAULT_ORDER_LIFETIME, ROLE_DEFAULT, OrderStatus, View, resolve_target
+from .pathing import bfs_next_action
+
+FINISHED = ("done", "failed", "blocked", "expired")
+
+
+class Controller:
+    def __init__(self, defaults: dict[str, str] | None = None) -> None:
+        self.orders: dict[str, dict] = {}   # agent_id -> order
+        self.status: dict[str, str] = {}    # agent_id -> status
+        self.defaults = defaults or {}      # agent_id -> default command (overrides role default)
+
+    def reset(self) -> None:
+        self.orders.clear(); self.status.clear()
+
+    # ---- orders -------------------------------------------------------
+    def set_orders(self, orders: list[dict], timestep: int) -> None:
+        for o in orders:
+            self.orders[o["agent_id"]] = {**o, "issued": timestep}
+            self.status[o["agent_id"]] = "active"
+
+    def report(self) -> list[OrderStatus]:
+        return [OrderStatus(a, o["command"], o.get("target"), self.status.get(a, "active"))
+                for a, o in self.orders.items()]
+
+    def purge_finished(self) -> None:
+        for a in [a for a, s in self.status.items() if s in FINISHED]:
+            self.orders.pop(a, None); self.status.pop(a, None)
+
+    def _command_for(self, agent) -> dict:
+        if agent.id in self.orders:
+            return self.orders[agent.id]
+        cmd = self.defaults.get(agent.id, ROLE_DEFAULT.get(agent.role, "hold"))
+        return {"agent_id": agent.id, "command": cmd, "target": None, "default": True}
+
+    # ---- goal logic -----------------------------------------------------
+    def _goal(self, view: View, agent, order: dict):
+        """Returns (goal_cell or None, finished_status or None). Reflexes live here."""
+        cmd, target = order["command"], order.get("target")
+        if agent.carrying:                       # reflex: a carrier always runs home
+            return view.own_base, None
+        if cmd == "capture_flag":
+            ef = view.enemy_flag
+            if ef is not None and ef.carried:     # a teammate already has it
+                return None, "done"
+            return view.enemy_base, None
+        if cmd == "defend_base":
+            # TODO(8): a defender standing on its own base cell tags every flag pickup immediately
+            # (pickup is resolved before tagging), which makes that base unbeatable. Once the group
+            # has decided how to handle this (rule change or a different defender behaviour),
+            # update this branch accordingly.
+            if view.own_flag.carried:             # reflex: chase the thief
+                return view.own_flag.pos, None
+            return view.own_base, None
+        if cmd == "hold":
+            return agent.pos, None
+        cell = resolve_target(view, target)
+        if cmd == "intercept":
+            if isinstance(target, str) and target.lower() == "enemy_carrier":
+                return (cell, None) if cell is not None else (None, "done")  # thief gone/tagged
+            return (cell, None) if cell is not None else (None, "failed")
+        if cmd in ("go_to", "scout"):
+            if cell is None:
+                return None, "failed"
+            return cell, ("done" if agent.pos == cell else None)
+        return None, "failed"
+
+    def update(self, view: View) -> None:
+        """Refresh statuses (arrived / expired / blocked / agent tagged)."""
+        for aid, order in list(self.orders.items()):
+            agent = view.agent(aid)
+            if agent is None or not agent.active:
+                self.orders.pop(aid, None); self.status.pop(aid, None); continue
+            if view.timestep - order["issued"] >= DEFAULT_ORDER_LIFETIME:
+                self.status[aid] = "expired"; continue
+            goal, finished = self._goal(view, agent, order)
+            if finished:
+                self.status[aid] = finished
+            elif goal is not None and bfs_next_action(view.width, view.height, view.obstacles, agent.pos, goal) is None:
+                self.status[aid] = "blocked"
+
+    def actions(self, view: View) -> dict[str, Action]:
+        result: dict[str, Action] = {}
+        for agent in view.agents:
+            if not agent.active:
+                continue
+            order = self._command_for(agent)
+            goal, _ = self._goal(view, agent, order)
+            move = None if goal is None else bfs_next_action(
+                view.width, view.height, view.obstacles, agent.pos, goal)
+            result[agent.id] = move if move is not None else Action.STAY
+        return result
diff --git a/src/strategies/llm_commander/llm.py b/src/strategies/llm_commander/llm.py
new file mode 100644
index 0000000..271488d
--- /dev/null
+++ b/src/strategies/llm_commander/llm.py
@@ -0,0 +1,97 @@
+"""LLM backends: MockLLM (offline stand-in), ClaudeLLM (API client), CachedLLM (answer cache)."""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from pathlib import Path
+
+
+class MockLLM:
+    """Offline stand-in that needs no API key. It applies a few fixed rules to the prompt text.
+    Used to test the pipeline end to end; not a result of the study."""
+
+    name = "mock"
+    last_usage = None
+
+    def complete(self, system: str, user: str) -> str:
+        agents = re.findall(r"^- (\w+) \((\w+)\) at \((\d+), (\d+)\)(.*)$", user, flags=re.M)
+        stolen = "ALERT: our flag is stolen" in user
+        center = re.search(r"center=\((\d+), (\d+)\)", user)
+        center = (int(center.group(1)), int(center.group(2))) if center else None
+        orders = []
+        for aid, role, x, y, rest in agents:
+            if "TAGGED" in rest:
+                continue
+            if stolen and "CARRYING" not in rest:
+                orders.append({"agent_id": aid, "command": "intercept", "target": "enemy_carrier",
+                               "rationale": "our flag was stolen, chase the thief"})
+            elif role == "scout" and center and (int(x), int(y)) != center and "ALERT" not in user:
+                orders.append({"agent_id": aid, "command": "scout", "target": "center",
+                               "rationale": "look at the middle of the map"})
+        return json.dumps({"orders": orders})
+
+
+class ClaudeLLM:
+    """LLM backend using the Anthropic API.
+    Requires the 'anthropic' package and the ANTHROPIC_API_KEY environment variable.
+
+    TODO(1): not yet run against the real API. On the first real run check the model name,
+    temperature / max_tokens settings, per-request latency and token cost.
+    """
+
+    def __init__(self, model: str = "claude-sonnet-5-5", temperature: float | None = 0.0, max_tokens: int = 700):
+        import anthropic
+
+        self._anthropic = anthropic
+        self.client = anthropic.Anthropic()
+        self.name, self.temperature, self.max_tokens = model, temperature, max_tokens
+        self.last_usage = None
+
+    def complete(self, system: str, user: str) -> str:
+        kwargs = dict(model=self.name, max_tokens=self.max_tokens, system=system,
+                      messages=[{"role": "user", "content": user}])
+        if self.temperature is not None:
+            kwargs["temperature"] = self.temperature
+        try:
+            r = self.client.messages.create(**kwargs)
+        except self._anthropic.BadRequestError as e:
+            if "temperature" in str(e).lower():       # some models reject this setting
+                kwargs.pop("temperature", None)
+                self.temperature = None
+                r = self.client.messages.create(**kwargs)
+            else:
+                raise
+        self.last_usage = {"in": r.usage.input_tokens, "out": r.usage.output_tokens}
+        return "".join(b.text for b in r.content if getattr(b, "type", "") == "text")
+
+
+class CachedLLM:
+    """Wraps another LLM and stores its answers in a file, keyed by the exact prompt.
+    Re-running the same game then makes no new API calls and gives identical results."""
+
+    def __init__(self, llm, path: str):
+        self.llm, self.path = llm, Path(path)
+        self.name = llm.name
+        self.last_usage = None
+        self.hits = 0
+        self.cache = json.loads(self.path.read_text()) if self.path.exists() else {}
+
+    def complete(self, system: str, user: str) -> str:
+        key = hashlib.sha256(f"{self.llm.name}\n{system}\n{user}".encode()).hexdigest()
+        if key in self.cache:
+            self.hits += 1
+            self.last_usage = {"in": 0, "out": 0, "cached": True}
+            return self.cache[key]
+        text = self.llm.complete(system, user)
+        self.last_usage = getattr(self.llm, "last_usage", None)
+        self.cache[key] = text
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self.path.write_text(json.dumps(self.cache))
+        return text
+
+
+# TODO(4a): control condition "random commander". Add a RandomOrdersLLM here with the same
+# complete(system, user) method that returns random but legal orders (random agent, command and
+# target, in the same JSON format). Comparing it with the real LLM shows whether the LLM's
+# orders add value beyond the controller's default behaviour.
