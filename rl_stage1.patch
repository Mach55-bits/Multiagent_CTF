@@ -0,0 +1,131 @@
+"""MAPPO update: PPO with a shared actor, a centralized critic and optional value normalization."""
+
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+from rl.buffer import Batch
+from rl.config import PPOConfig
+from rl.networks import ActorCritic
+
+
+class ValueNorm(nn.Module):
+    """Running mean/std of return targets (the critic predicts normalized returns)."""
+
+    def __init__(self, enabled: bool) -> None:
+        super().__init__()
+        self.enabled = enabled
+        self.register_buffer("mean", torch.zeros(()))
+        self.register_buffer("var", torch.ones(()))
+        self.register_buffer("count", torch.zeros(()))
+
+    @torch.no_grad()
+    def update(self, x: torch.Tensor) -> None:
+        if not self.enabled:
+            return
+        n = float(x.numel())
+        batch_mean, batch_var = x.mean(), x.var(unbiased=False)
+        total = self.count + n
+        delta = batch_mean - self.mean
+        self.mean += delta * n / total
+        self.var.copy_((self.var * self.count + batch_var * n + delta**2 * self.count * n / total) / total)
+        self.count.copy_(total)
+
+    def normalize(self, x: torch.Tensor) -> torch.Tensor:
+        return (x - self.mean) / torch.sqrt(self.var + 1e-8) if self.enabled else x
+
+    def denormalize(self, x: torch.Tensor) -> torch.Tensor:
+        return x * torch.sqrt(self.var + 1e-8) + self.mean if self.enabled else x
+
+
+class MAPPO:
+    def __init__(self, model: ActorCritic, cfg: PPOConfig, value_norm: ValueNorm) -> None:
+        self.model = model
+        self.cfg = cfg
+        self.value_norm = value_norm
+        self.optimizer = torch.optim.Adam(model.parameters(), lr=cfg.learning_rate, eps=cfg.adam_eps)
+
+    def update(
+        self,
+        batch: Batch,
+        learning_rate: float,
+        entropy_coef: float,
+        generator: torch.Generator | None = None,
+    ) -> dict[str, float]:
+        cfg = self.cfg
+        for group in self.optimizer.param_groups:
+            group["lr"] = learning_rate
+
+        self.value_norm.update(batch.returns)
+        targets = self.value_norm.normalize(batch.returns)
+
+        advantages = batch.advantages
+        if cfg.normalize_advantages:
+            alive = batch.alive > 0
+            if alive.any():
+                mean, std = advantages[alive].mean(), advantages[alive].std(unbiased=False)
+                advantages = (advantages - mean) / (std + 1e-8)
+
+        stats = {"policy_loss": 0.0, "value_loss": 0.0, "entropy": 0.0, "approx_kl": 0.0, "clip_fraction": 0.0}
+        updates = 0
+        n = len(batch)
+        sizes = [n // cfg.num_minibatches + (1 if i < n % cfg.num_minibatches else 0) for i in range(cfg.num_minibatches)]
+        for _ in range(cfg.epochs):
+            order = torch.randperm(n, generator=generator, device=batch.actions.device)
+            start = 0
+            for size in sizes:
+                idx = order[start : start + size]
+                start += size
+                if idx.numel() == 0:
+                    continue
+                m = self._minibatch_loss(batch, idx, advantages, targets, entropy_coef)
+                self.optimizer.zero_grad()
+                m["loss"].backward()
+                nn.utils.clip_grad_norm_(self.model.parameters(), cfg.max_grad_norm)
+                self.optimizer.step()
+                for key in stats:
+                    stats[key] += float(m[key])
+                updates += 1
+        stats = {k: v / max(updates, 1) for k, v in stats.items()}
+        stats["explained_variance"] = self._explained_variance(batch)
+        return stats
+
+    def _minibatch_loss(self, b: Batch, idx, advantages, targets, entropy_coef) -> dict:
+        cfg = self.cfg
+        new_log_probs, entropy = self.model.evaluate_actions(
+            b.grid[idx], b.vec[idx], b.mask[idx], b.role_index[idx], b.actions[idx]
+        )
+        values = self.model.value(b.critic_grid[idx], b.critic_vec[idx])
+        alive = b.alive[idx]
+        denom = alive.sum().clamp(min=1.0)
+
+        log_ratio = new_log_probs - b.old_log_probs[idx]
+        ratio = log_ratio.exp()
+        adv = advantages[idx]
+        surrogate = torch.min(ratio * adv, ratio.clamp(1 - cfg.clip_epsilon, 1 + cfg.clip_epsilon) * adv)
+        policy_loss = -(surrogate * alive).sum() / denom
+        entropy_mean = (entropy * alive).sum() / denom
+        # The critic learns from every sample: eliminated agents still share the team outcome.
+        value_loss = 0.5 * ((values - targets[idx]) ** 2).mean()
+        loss = policy_loss + cfg.value_coef * value_loss - entropy_coef * entropy_mean
+
+        with torch.no_grad():
+            approx_kl = (((ratio - 1) - log_ratio) * alive).sum() / denom
+            clipped = ((ratio - 1).abs() > cfg.clip_epsilon).float()
+            clip_fraction = (clipped * alive).sum() / denom
+        return {
+            "loss": loss,
+            "policy_loss": policy_loss.detach(),
+            "value_loss": value_loss.detach(),
+            "entropy": entropy_mean.detach(),
+            "approx_kl": approx_kl,
+            "clip_fraction": clip_fraction,
+        }
+
+    @torch.no_grad()
+    def _explained_variance(self, batch: Batch) -> float:
+        var = batch.returns.var(unbiased=False)
+        if var < 1e-12:
+            return 0.0
+        return float(1.0 - (batch.returns - batch.old_values).var(unbiased=False) / var)
diff --git a/src/rl/navigation.py b/src/rl/navigation.py
new file mode 100644
index 0000000..4acd963
--- /dev/null
+++ b/src/rl/navigation.py
@@ -0,0 +1,81 @@
+"""Shortest-path distances on the grid (static walls only).
+
+Used for reward shaping and by scripted opponents. Manhattan distance is wrong on
+this map (the wall forces detours through the top/bottom gaps), so true BFS path
+distances are precomputed for every cell pair once per map.
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from collections.abc import Sequence
+from random import Random
+
+import numpy as np
+
+from ctf.actions import Action
+
+Cell = tuple[int, int]
+MOVES: tuple[Action, ...] = (Action.UP, Action.DOWN, Action.LEFT, Action.RIGHT)
+
+
+class GridNav:
+    def __init__(self, traversable: Sequence[Sequence[bool]]) -> None:
+        self.height = len(traversable)
+        self.width = len(traversable[0])
+        self._free = np.array(traversable, dtype=bool)
+        n = self.height * self.width
+        #: value used for "no path"; larger than any real shortest-path length
+        self.unreachable = n
+        self._dist = np.full((n, n), self.unreachable, dtype=np.int32)
+        for y in range(self.height):
+            for x in range(self.width):
+                if self._free[y, x]:
+                    self._bfs_from((x, y))
+
+    def _index(self, cell: Cell) -> int:
+        return cell[1] * self.width + cell[0]
+
+    def is_free(self, x: int, y: int) -> bool:
+        return 0 <= x < self.width and 0 <= y < self.height and bool(self._free[y, x])
+
+    def _bfs_from(self, source: Cell) -> None:
+        row = self._dist[self._index(source)]
+        row[self._index(source)] = 0
+        queue: deque[Cell] = deque([source])
+        while queue:
+            x, y = queue.popleft()
+            d = row[self._index((x, y))]
+            for move in MOVES:
+                dx, dy = move.delta()
+                nx, ny = x + dx, y + dy
+                if self.is_free(nx, ny) and row[self._index((nx, ny))] == self.unreachable:
+                    row[self._index((nx, ny))] = d + 1
+                    queue.append((nx, ny))
+
+    def distance(self, a: Cell, b: Cell) -> int:
+        return int(self._dist[self._index(a), self._index(b)])
+
+    def distance_map(self, target: Cell) -> np.ndarray:
+        """(H, W) array of path distances from every cell to ``target``."""
+        return self._dist[self._index(target)].reshape(self.height, self.width)
+
+    @property
+    def max_distance(self) -> int:
+        reachable = self._dist[self._dist < self.unreachable]
+        return int(reachable.max()) if reachable.size else 0
+
+    def step_toward(self, src: Cell, dst: Cell, rng: Random | None = None) -> Action:
+        """Move that shortens the path to ``dst``; STAY if already there or unreachable."""
+        if src == dst or self.distance(src, dst) >= self.unreachable:
+            return Action.STAY
+        here = self.distance(src, dst)
+        best: list[Action] = []
+        for move in MOVES:
+            dx, dy = move.delta()
+            nxt = (src[0] + dx, src[1] + dy)
+            if self.is_free(*nxt) and self.distance(nxt, dst) < here:
+                best.append(move)
+        if not best:
+            return Action.STAY
+        return rng.choice(best) if rng is not None else best[0]
diff --git a/src/rl/networks.py b/src/rl/networks.py
new file mode 100644
index 0000000..70b5dc9
--- /dev/null
+++ b/src/rl/networks.py
@@ -0,0 +1,128 @@
+"""CNN actor-critic with role-conditioned policy heads (parameter sharing across agents).
+
+Actor:  grid channels --conv--> flatten --fc--> concat(role/scalars) --fc--> role head
+Critic: privileged global-state channels, same encoder shape, one value per agent.
+Invalid actions (walls, edges) are masked out of the policy distribution.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import torch
+from torch import nn
+from torch.distributions import Categorical
+
+from ctf.config import CTFConfig
+from rl.canonical import NUM_ACTIONS
+from rl.config import ModelConfig
+from rl.features import ACTOR_CHANNELS, ACTOR_VECTOR, CRITIC_CHANNELS, CRITIC_VECTOR, ROLE_ORDER
+
+
+@dataclass(frozen=True)
+class NetworkSpec:
+    actor_channels: int
+    critic_channels: int
+    height: int
+    width: int
+    actor_vec_dim: int
+    critic_vec_dim: int
+    num_actions: int
+    num_roles: int
+
+    @classmethod
+    def from_env(cls, env_config: CTFConfig) -> "NetworkSpec":
+        return cls(
+            actor_channels=len(ACTOR_CHANNELS),
+            critic_channels=len(CRITIC_CHANNELS),
+            height=env_config.height,
+            width=env_config.width,
+            actor_vec_dim=len(ACTOR_VECTOR),
+            critic_vec_dim=len(CRITIC_VECTOR),
+            num_actions=NUM_ACTIONS,
+            num_roles=len(ROLE_ORDER),
+        )
+
+
+def _init(module: nn.Module, gain: float) -> None:
+    if isinstance(module, (nn.Linear, nn.Conv2d)):
+        nn.init.orthogonal_(module.weight, gain=gain)
+        nn.init.zeros_(module.bias)
+
+
+class ConvEncoder(nn.Module):
+    def __init__(
+        self, in_channels: int, height: int, width: int, vec_dim: int, cfg: ModelConfig
+    ) -> None:
+        super().__init__()
+        layers: list[nn.Module] = []
+        channels = in_channels
+        for out_channels in cfg.conv_channels:
+            layers += [nn.Conv2d(channels, out_channels, cfg.kernel_size, padding=cfg.kernel_size // 2), nn.ReLU()]
+            channels = out_channels
+        self.conv = nn.Sequential(*layers)
+        self.fc_grid = nn.Linear(channels * height * width, cfg.hidden_size)
+        self.fc_mix = nn.Linear(cfg.hidden_size + vec_dim, cfg.hidden_size)
+        self.apply(lambda m: _init(m, gain=float(np.sqrt(2.0))))
+
+    def forward(self, grid: torch.Tensor, vec: torch.Tensor) -> torch.Tensor:
+        x = torch.relu(self.fc_grid(self.conv(grid).flatten(1)))
+        return torch.relu(self.fc_mix(torch.cat([x, vec], dim=1)))
+
+
+class ActorCritic(nn.Module):
+    def __init__(self, spec: NetworkSpec, cfg: ModelConfig) -> None:
+        super().__init__()
+        self.spec = spec
+        self.actor_encoder = ConvEncoder(spec.actor_channels, spec.height, spec.width, spec.actor_vec_dim, cfg)
+        self.role_heads = nn.Linear(cfg.hidden_size, spec.num_roles * spec.num_actions)
+        self.critic_encoder = ConvEncoder(spec.critic_channels, spec.height, spec.width, spec.critic_vec_dim, cfg)
+        self.value_head = nn.Linear(cfg.hidden_size, 1)
+        _init(self.role_heads, gain=0.01)
+        _init(self.value_head, gain=1.0)
+
+    # ----------------------------------------------------------------- policy
+
+    def policy(
+        self,
+        grid: torch.Tensor,
+        vec: torch.Tensor,
+        mask: torch.Tensor,
+        role_index: torch.Tensor,
+    ) -> Categorical:
+        hidden = self.actor_encoder(grid, vec)
+        all_logits = self.role_heads(hidden).view(-1, self.spec.num_roles, self.spec.num_actions)
+        logits = all_logits[torch.arange(all_logits.shape[0], device=grid.device), role_index]
+        logits = logits.masked_fill(~mask, torch.finfo(logits.dtype).min)
+        return Categorical(logits=logits)
+
+    @torch.no_grad()
+    def act(
+        self,
+        grid: torch.Tensor,
+        vec: torch.Tensor,
+        mask: torch.Tensor,
+        role_index: torch.Tensor,
+        deterministic: bool = False,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        dist = self.policy(grid, vec, mask, role_index)
+        actions = dist.probs.argmax(dim=-1) if deterministic else dist.sample()
+        return actions, dist.log_prob(actions)
+
+    def evaluate_actions(
+        self,
+        grid: torch.Tensor,
+        vec: torch.Tensor,
+        mask: torch.Tensor,
+        role_index: torch.Tensor,
+        actions: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        dist = self.policy(grid, vec, mask, role_index)
+        return dist.log_prob(actions), dist.entropy()
+
+    # ----------------------------------------------------------------- critic
+
+    def value(self, critic_grid: torch.Tensor, critic_vec: torch.Tensor) -> torch.Tensor:
+        """Value in the (possibly normalized) scale the critic is trained on."""
+        return self.value_head(self.critic_encoder(critic_grid, critic_vec)).squeeze(-1)
diff --git a/src/rl/opponents.py b/src/rl/opponents.py
new file mode 100644
index 0000000..0b46996
--- /dev/null
+++ b/src/rl/opponents.py
@@ -0,0 +1,154 @@
+"""Opponent teams for training and evaluation.
+
+Kinds (selected by ``OpponentSpec.kind`` in the curriculum config):
+
+``random``    uniformly random actions.
+``stay``      never moves (note: an agent standing on its own flag cell makes that
+              flag unpickable, because pickup and tag happen in the same step).
+``scripted``  a simple rule-based team: attackers run to the enemy flag and home,
+              defenders hold a post and chase flag carriers, scouts wander or wait.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+from random import Random
+
+from ctf.actions import Action
+from ctf.agent import Team
+from ctf.config import CTFConfig
+from ctf.game_state import FlagStatus
+from ctf.observations import TeamObservation
+from rl.config import OpponentSpec
+from rl.navigation import MOVES, GridNav
+from rl.schema import ConfigError, from_dict
+from strategies import BaseStrategy, Role, StayStrategy
+
+KNOWN_KINDS = ("random", "stay", "scripted")
+
+
+class GuardMode(str, Enum):
+    ON_FLAG = "on_flag"  # defender parks on its own flag cell (unbeatable while it stays)
+    LEASH = "leash"  # defender holds a post `guard_leash` cells in front of the flag
+
+
+class ScoutBehavior(str, Enum):
+    RANDOM = "random"
+    STAY = "stay"
+
+
+@dataclass(frozen=True)
+class ScriptedParams:
+    roles: list[Role]  # role of each team slot, in sorted agent-id order
+    guard_mode: GuardMode
+    guard_leash: int
+    scout_behavior: ScoutBehavior
+
+
+def _active_team_agents(observation: TeamObservation, team: Team) -> list:
+    return [a for a in observation.agents.values() if a.team is team and a.active]
+
+
+class RandomStrategy(BaseStrategy):
+    def __init__(self, rng: Random) -> None:
+        self._rng = rng
+
+    def act(self, observation: TeamObservation, team: Team) -> dict[str, Action]:
+        actions = list(Action)
+        return {a.agent_id: self._rng.choice(actions) for a in _active_team_agents(observation, team)}
+
+
+class ScriptedTeamStrategy(BaseStrategy):
+    def __init__(self, env_config: CTFConfig, params: ScriptedParams, rng: Random) -> None:
+        if len(params.roles) != env_config.agents_per_team:
+            raise ConfigError(
+                f"scripted opponent has {len(params.roles)} roles for "
+                f"{env_config.agents_per_team} agents per team"
+            )
+        if params.guard_leash < 0:
+            raise ConfigError("scripted opponent guard_leash must be >= 0")
+        self._cfg = env_config
+        self._params = params
+        self._rng = rng
+        traversable = [
+            [(x, y) not in set(env_config.obstacles) for x in range(env_config.width)]
+            for y in range(env_config.height)
+        ]
+        self._nav = GridNav(traversable)
+        self._post = {team: self._leash_post(team) for team in Team}
+
+    def _bases(self, team: Team) -> tuple[tuple[int, int], tuple[int, int]]:
+        red, blue = self._cfg.red_base, self._cfg.blue_base
+        return (red, blue) if team is Team.RED else (blue, red)
+
+    def _leash_post(self, team: Team) -> tuple[int, int]:
+        own, other = self._bases(team)
+        if self._params.guard_mode is GuardMode.ON_FLAG or self._params.guard_leash == 0:
+            return own
+        ring = [
+            (x, y)
+            for y in range(self._cfg.height)
+            for x in range(self._cfg.width)
+            if self._nav.distance(own, (x, y)) == self._params.guard_leash
+        ]
+        if not ring:
+            return own
+        return min(ring, key=lambda c: (self._nav.distance(c, other), c[1], c[0]))
+
+    def act(self, observation: TeamObservation, team: Team) -> dict[str, Action]:
+        own_base, enemy_base = self._bases(team)
+        own_flag = observation.flags[team]
+        enemy_flag = observation.flags.get(team.opponent)
+        enemy_carriers = [
+            a
+            for a in observation.agents.values()
+            if a.team is not team and a.active and a.carrying_flag
+        ]
+        mine = sorted(
+            (a for a in observation.agents.values() if a.team is team), key=lambda a: a.agent_id
+        )
+        actions: dict[str, Action] = {}
+        for slot, agent in enumerate(mine):
+            if not agent.active:
+                continue
+            here = (agent.x, agent.y)
+            role = self._params.roles[slot]
+            if role is Role.ATTACKER:
+                if agent.carrying_flag:
+                    target = own_base
+                elif enemy_flag is not None:
+                    target = (enemy_flag.x, enemy_flag.y)
+                else:
+                    target = enemy_base
+                actions[agent.agent_id] = self._nav.step_toward(here, target, self._rng)
+            elif role is Role.DEFENDER:
+                if own_flag.status is FlagStatus.CARRIED:
+                    target = (own_flag.x, own_flag.y)
+                elif enemy_carriers:
+                    nearest = min(enemy_carriers, key=lambda c: self._nav.distance(here, (c.x, c.y)))
+                    target = (nearest.x, nearest.y)
+                else:
+                    target = self._post[team]
+                actions[agent.agent_id] = self._nav.step_toward(here, target, self._rng)
+            else:
+                actions[agent.agent_id] = self._scout_action(here)
+        return actions
+
+    def _scout_action(self, here: tuple[int, int]) -> Action:
+        if self._params.scout_behavior is ScoutBehavior.STAY:
+            return Action.STAY
+        options = [m for m in MOVES if self._nav.is_free(here[0] + m.delta()[0], here[1] + m.delta()[1])]
+        return self._rng.choice(options) if options else Action.STAY
+
+
+def build_opponent(spec: OpponentSpec, env_config: CTFConfig, rng: Random) -> BaseStrategy:
+    """Create a fresh opponent from its config entry (raises ConfigError if invalid)."""
+    if spec.kind not in KNOWN_KINDS:
+        raise ConfigError(f"unknown opponent kind {spec.kind!r}; known kinds: {KNOWN_KINDS}")
+    if spec.kind == "scripted":
+        params = from_dict(ScriptedParams, spec.params, f"opponent[{spec.kind}].params")
+        return ScriptedTeamStrategy(env_config, params, rng)
+    if spec.params:
+        raise ConfigError(f"opponent kind {spec.kind!r} takes no params, got {sorted(spec.params)}")
+    return RandomStrategy(rng) if spec.kind == "random" else StayStrategy()
diff --git a/src/rl/rewards.py b/src/rl/rewards.py
new file mode 100644
index 0000000..e50a824
--- /dev/null
+++ b/src/rl/rewards.py
@@ -0,0 +1,173 @@
+"""Reward computation (the environment itself always returns 0).
+
+Per-agent reward = team outcome + individual events + potential-based shaping
+(+ scout exploration bonus, step penalty). Shaping uses true BFS path distances, so
+it respects the wall, and is potential-based (F = gamma*phi(s') - phi(s)), which does
+not change which policy is optimal. All weights come from ``RewardsConfig``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from ctf.agent import Agent, Team
+from ctf.config import CTFConfig
+from ctf.game_state import FlagStatus
+from ctf.observations import GlobalObservation, manhattan_cells
+from rl.config import RewardsConfig
+from rl.navigation import GridNav
+from strategies.roles import Role
+
+COMPONENTS = (
+    "outcome",
+    "pickup",
+    "tagged",
+    "tag",
+    "team_share",
+    "potential",
+    "scout",
+    "step",
+)
+
+
+@dataclass(frozen=True)
+class RewardResult:
+    total: np.ndarray  # (A,) float64
+    components: dict[str, np.ndarray]  # each (A,)
+
+
+class RewardCalculator:
+    def __init__(
+        self,
+        env_config: CTFConfig,
+        team: Team,
+        roles: list[Role],
+        cfg: RewardsConfig,
+        gamma: float,
+        nav: GridNav,
+    ) -> None:
+        self.cfg = cfg
+        self.gamma = gamma
+        self.team = team
+        self.roles = roles
+        self.nav = nav
+        self.width, self.height = env_config.width, env_config.height
+        prefix = "R" if team is Team.RED else "B"
+        self.agent_ids = [f"{prefix}{i}" for i in range(1, env_config.agents_per_team + 1)]
+        self._slot_of = {aid: i for i, aid in enumerate(self.agent_ids)}
+        own = env_config.red_base if team is Team.RED else env_config.blue_base
+        other = env_config.blue_base if team is Team.RED else env_config.red_base
+        self.own_base, self.enemy_base = own, other
+        # Distance a flag must be carried from its base to ours; makes the attacker's
+        # potential continuous at the moment of pickup.
+        self._carry_offset = nav.distance(other, own)
+        self._seen = np.zeros((self.height, self.width), dtype=bool)
+        self._prev_potential = np.zeros(len(self.agent_ids))
+
+    # ------------------------------------------------------------------ lifecycle
+
+    def reset(self, obs: GlobalObservation) -> None:
+        self._seen[:] = False
+        self._mark_seen(obs, credit=False)
+        self._prev_potential = self._potentials(obs)
+
+    # ------------------------------------------------------------------ potentials
+
+    def _potentials(self, obs: GlobalObservation) -> np.ndarray:
+        phi = np.zeros(len(self.agent_ids))
+        own_flag = obs.flags[self.team]
+        enemy_flag = obs.flags[self.team.opponent]
+        for slot, aid in enumerate(self.agent_ids):
+            agent = obs.agents[aid]
+            if not agent.active or obs.terminated:
+                continue  # absorbing states have potential 0
+            here = (agent.x, agent.y)
+            role = self.roles[slot]
+            if role is Role.ATTACKER:
+                if agent.carrying_flag:
+                    d_home = self.nav.distance(here, self.own_base)
+                    phi[slot] = self.cfg.attacker_potential * (self._carry_offset - d_home)
+                else:
+                    target = (enemy_flag.x, enemy_flag.y)
+                    phi[slot] = -self.cfg.attacker_potential * self.nav.distance(here, target)
+            elif role is Role.DEFENDER:
+                target = (own_flag.x, own_flag.y)
+                phi[slot] = -self.cfg.defender_potential * self.nav.distance(here, target)
+        return phi
+
+    # ----------------------------------------------------------------- exploration
+
+    def _mark_seen(self, obs: GlobalObservation, *, credit: bool) -> np.ndarray:
+        """Update the seen-set; return newly seen cell counts credited per agent."""
+        new_counts = np.zeros(len(self.agent_ids))
+        for slot, aid in enumerate(self.agent_ids):
+            agent = obs.agents[aid]
+            if not agent.active:
+                continue
+            cells = manhattan_cells(agent.x, agent.y, obs.visibility_radius, self.width, self.height)
+            fresh = 0
+            for x, y in cells:
+                if not self._seen[y, x]:
+                    self._seen[y, x] = True
+                    fresh += 1
+            if credit:
+                new_counts[slot] = fresh
+        return new_counts
+
+    # ---------------------------------------------------------------------- step
+
+    def step(
+        self,
+        obs: GlobalObservation,
+        prev_agents: dict[str, Agent],
+        events: list[dict],
+        scout_scale: float,
+    ) -> RewardResult:
+        """Rewards for the transition that produced ``obs`` (events as emitted by the env)."""
+        n = len(self.agent_ids)
+        comp = {name: np.zeros(n) for name in COMPONENTS}
+        cfg = self.cfg
+
+        # Team outcome: everyone shares it, including eliminated agents.
+        if obs.terminated:
+            if obs.winner is self.team:
+                comp["outcome"][:] = cfg.win
+            elif obs.winner is not None:
+                comp["outcome"][:] = cfg.loss
+            else:
+                comp["outcome"][:] = cfg.timeout
+
+        for event in events:
+            kind = event.get("type")
+            if kind == "flag_pickup":
+                slot = self._slot_of.get(event["agent_id"])
+                if slot is not None:
+                    comp["pickup"][slot] += cfg.pickup
+            elif kind == "tag":
+                carrier = self._slot_of.get(event["agent_id"])
+                tagger = self._slot_of.get(event["by_agent_id"])
+                if carrier is not None:
+                    comp["tagged"][carrier] += cfg.tagged_while_carrying
+                if tagger is not None:
+                    comp["tag"][tagger] += cfg.tag_enemy_carrier
+                    for slot in range(n):
+                        if slot != tagger:
+                            comp["team_share"][slot] += cfg.tag_team_share
+
+        # Potential-based shaping.
+        phi = self._potentials(obs)
+        comp["potential"] = self.gamma * phi - self._prev_potential
+        self._prev_potential = phi
+
+        # Scout exploration bonus and per-step cost (only for agents that acted).
+        fresh = self._mark_seen(obs, credit=True)
+        for slot in range(n):
+            if self.roles[slot] is Role.SCOUT:
+                comp["scout"][slot] = cfg.scout_new_cell * scout_scale * fresh[slot]
+            if prev_agents[self.agent_ids[slot]].active:
+                comp["step"][slot] = cfg.step_penalty
+
+        total = sum(comp.values())
+        return RewardResult(total=np.asarray(total, dtype=np.float64), components=comp)
