index 0000000..029d830
--- /dev/null
+++ b/src/rl/train.py
@@ -0,0 +1,96 @@
+"""Training entry point.
+
+    python -m rl.train --config configs/rl/default.yaml
+    python -m rl.train --set ppo.learning_rate=0.0001 --set run.name=lr_test
+    python -m rl.train --resume latest
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import platform
+import sys
+import time
+from pathlib import Path
+
+import torch
+import yaml
+
+from ctf.config import config_to_dict
+from rl.checkpoint import git_commit
+from rl.config import config_to_plain, load_base_env_config, load_rl_config
+from rl.schema import ConfigError, parse_override
+from rl.trainer import Trainer
+
+
+def _parser() -> argparse.ArgumentParser:
+    p = argparse.ArgumentParser(description="Train the MAPPO Capture-the-Flag agent.")
+    p.add_argument("--config", default="configs/rl/default.yaml", help="RL config YAML")
+    p.add_argument("--set", action="append", default=[], dest="overrides", metavar="KEY=VALUE",
+                   help="override a config value by dotted path (repeatable)")
+    p.add_argument("--resume", default=None, metavar="latest|PATH",
+                   help="continue from a checkpoint ('latest' = this run's latest.pt)")
+    p.add_argument("--print-config", action="store_true", help="print the resolved config and exit")
+    return p
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        overrides = dict(parse_override(text) for text in args.overrides)
+        cfg = load_rl_config(args.config, overrides)
+        env_config = load_base_env_config(cfg, root=Path.cwd())
+    except (ConfigError, ValueError, FileNotFoundError) as exc:
+        print(f"config error: {exc}", file=sys.stderr)
+        return 2
+
+    if args.print_config:
+        print(yaml.safe_dump(config_to_plain(cfg), sort_keys=False))
+        return 0
+
+    run_dir = Path(cfg.run.output_dir) / cfg.run.name
+    resume_path: Path | None = None
+    if args.resume is not None:
+        resume_path = run_dir / "checkpoints" / "latest.pt" if args.resume == "latest" else Path(args.resume)
+        if not resume_path.exists():
+            print(f"cannot resume: {resume_path} does not exist", file=sys.stderr)
+            return 2
+    elif (run_dir / "metrics.jsonl").exists():
+        print(
+            f"run directory {run_dir} already has results. Pick another run.name "
+            f"(--set run.name=...) or continue it with --resume latest.",
+            file=sys.stderr,
+        )
+        return 2
+
+    run_dir.mkdir(parents=True, exist_ok=True)
+    suffix = "" if resume_path is None else f".resume_{int(time.time())}"
+    (run_dir / f"config{suffix}.yaml").write_text(
+        yaml.safe_dump(config_to_plain(cfg), sort_keys=False), encoding="utf-8"
+    )
+    (run_dir / f"env_config{suffix}.yaml").write_text(
+        yaml.safe_dump(config_to_dict(env_config), sort_keys=False), encoding="utf-8"
+    )
+    (run_dir / f"run_info{suffix}.json").write_text(
+        json.dumps({
+            "git_commit": git_commit(),
+            "python": platform.python_version(),
+            "torch": torch.__version__,
+            "platform": platform.platform(),
+            "argv": sys.argv,
+            "started": time.strftime("%Y-%m-%d %H:%M:%S"),
+        }, indent=2),
+        encoding="utf-8",
+    )
+
+    print(f"run: {run_dir}  device: {cfg.run.device}  envs: {cfg.rollout.num_envs}  "
+          f"workers: {cfg.rollout.num_workers}  total steps: {cfg.rollout.total_steps:,}", flush=True)
+    trainer = Trainer(cfg, env_config, run_dir, resume_path)
+    counters = trainer.run()
+    print(f"finished at step {counters['total_steps']:,} (update {counters['update']})")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/rl/trainer.py b/src/rl/trainer.py
new file mode 100644
index 0000000..657029c
--- /dev/null
+++ b/src/rl/trainer.py
@@ -0,0 +1,171 @@
+"""MAPPO training loop."""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import torch
+
+from ctf.config import CTFConfig
+from rl.buffer import RolloutBuffer
+from rl.checkpoint import CheckpointManager, load_checkpoint, restore_training_state
+from rl.config import RLConfig
+from rl.curriculum import Curriculum
+from rl.mappo import MAPPO, ValueNorm
+from rl.metrics import MetricsLogger, summarize_episodes
+from rl.networks import ActorCritic, NetworkSpec
+from rl.rollout import collect
+from rl.vec_env import make_vec_env
+
+
+def resolve_device(name: str) -> torch.device:
+    if name == "auto":
+        if torch.cuda.is_available():
+            return torch.device("cuda")
+        if getattr(torch.backends, "mps", None) is not None and torch.backends.mps.is_available():
+            return torch.device("mps")
+        return torch.device("cpu")
+    return torch.device(name)
+
+
+def _lerp(start: float, end: float, progress: float) -> float:
+    return start + (end - start) * min(max(progress, 0.0), 1.0)
+
+
+class Trainer:
+    def __init__(
+        self,
+        cfg: RLConfig,
+        env_config: CTFConfig,
+        run_dir: Path,
+        resume_from: Path | None = None,
+    ) -> None:
+        self.cfg, self.env_config, self.run_dir = cfg, env_config, run_dir
+        self.device = resolve_device(cfg.run.device)
+        torch.set_num_threads(cfg.run.torch_threads)
+        torch.manual_seed(cfg.run.seed)
+
+        spec = NetworkSpec.from_env(env_config)
+        self.model = ActorCritic(spec, cfg.model).to(self.device)
+        self.value_norm = ValueNorm(cfg.ppo.value_normalization).to(self.device)
+        self.algo = MAPPO(self.model, cfg.ppo, self.value_norm)
+        self.curriculum = Curriculum(cfg.curriculum.phases)
+        self.checkpoints = CheckpointManager(run_dir, cfg.run.keep_checkpoints)
+        self.counters = {"total_steps": 0, "update": 0}
+        if resume_from is not None:
+            payload = load_checkpoint(resume_from, map_location="cpu")
+            self.counters = restore_training_state(
+                payload,
+                model=self.model,
+                optimizer=self.algo.optimizer,
+                value_norm=self.value_norm,
+                curriculum=self.curriculum,
+            )
+        self.buffer = RolloutBuffer(
+            cfg.rollout.rollout_length, cfg.rollout.num_envs, env_config.agents_per_team, spec
+        )
+        self.generator = None if self.device.type == "mps" else torch.Generator(device=self.device)
+        if self.generator is not None:
+            self.generator.manual_seed(cfg.run.seed + self.counters["update"])
+
+    # ------------------------------------------------------------------ helpers
+
+    def _state(self) -> dict:
+        return {
+            "model": self.model,
+            "optimizer": self.algo.optimizer,
+            "value_norm": self.value_norm,
+            "curriculum": self.curriculum,
+            "counters": self.counters,
+            "config": self.cfg,
+            "env_config": self.env_config,
+        }
+
+    def _scalars(self, stats, episodes, lr, entropy_coef, scout_scale, sps) -> dict[str, float]:
+        roles = [r.value for r in self.cfg.roles.slots]
+        scalars = {f"train/{k}": v for k, v in stats.items()}
+        scalars.update({f"episode/{k}": v for k, v in summarize_episodes(episodes, roles).items()})
+        scalars["curriculum/phase"] = float(self.curriculum.index)
+        if self.curriculum.win_rate is not None:
+            scalars["curriculum/rolling_win_rate"] = self.curriculum.win_rate
+        scalars["schedule/learning_rate"] = lr
+        scalars["schedule/entropy_coef"] = entropy_coef
+        scalars["schedule/scout_scale"] = scout_scale
+        scalars["perf/steps_per_sec"] = sps
+        return scalars
+
+    # --------------------------------------------------------------------- train
+
+    def run(self) -> dict[str, int]:
+        cfg = self.cfg
+        steps_per_update = cfg.rollout.rollout_length * cfg.rollout.num_envs
+        # Resumed runs use different env seeds than the segment they continue.
+        seed = cfg.run.seed + self.counters["update"] * cfg.rollout.num_envs
+        vec = make_vec_env(cfg, self.env_config, seed)
+        logger = MetricsLogger(self.run_dir, cfg.run.tensorboard)
+        pending: list[dict] = []
+        window_start, window_steps = time.time(), 0
+        next_checkpoint = (self.counters["total_steps"] // cfg.run.checkpoint_every_steps + 1) * (
+            cfg.run.checkpoint_every_steps
+        )
+        try:
+            vec.set_phase(self.curriculum.index)
+            obs = vec.reset()
+            while self.counters["total_steps"] < cfg.rollout.total_steps:
+                total = self.counters["total_steps"]
+                progress = total / cfg.rollout.total_steps
+                lr = _lerp(cfg.ppo.learning_rate, cfg.ppo.learning_rate_final, progress)
+                entropy_coef = _lerp(cfg.ppo.entropy_coef, cfg.ppo.entropy_coef_final, progress)
+                scout_scale = max(0.0, 1.0 - total / cfg.rewards.scout_anneal_steps)
+                vec.set_scout_scale(scout_scale)
+
+                obs, episodes = collect(vec, obs, self.model, self.value_norm, self.buffer, self.device)
+                self.buffer.compute_gae(cfg.ppo.gamma, cfg.ppo.gae_lambda)
+                self.model.train()
+                stats = self.algo.update(self.buffer.to_batch(self.device), lr, entropy_coef, self.generator)
+
+                self.counters["total_steps"] += steps_per_update
+                self.counters["update"] += 1
+                window_steps += steps_per_update
+                pending.extend(episodes)
+
+                if self.curriculum.record([e["outcome"] for e in episodes], steps_per_update):
+                    phase = self.curriculum.phase
+                    vec.set_phase(self.curriculum.index)
+                    logger.event(self.counters["total_steps"], "phase_advance",
+                                 phase_index=self.curriculum.index, phase=phase.name)
+                    self.checkpoints.save_phase_start(self.curriculum.index, phase.name, **self._state())
+                    print(f"--> phase {self.curriculum.index}: {phase.name}", flush=True)
+
+                if self.counters["update"] % cfg.run.log_every_updates == 0:
+                    sps = window_steps / max(time.time() - window_start, 1e-9)
+                    scalars = self._scalars(stats, pending, lr, entropy_coef, scout_scale, sps)
+                    logger.log(self.counters["total_steps"], scalars)
+                    self._print(scalars)
+                    pending, window_start, window_steps = [], time.time(), 0
+
+                if self.counters["total_steps"] >= next_checkpoint:
+                    self.checkpoints.save_periodic(self.counters["total_steps"], **self._state())
+                    next_checkpoint += cfg.run.checkpoint_every_steps
+            self.checkpoints.save_periodic(self.counters["total_steps"], **self._state())
+        except KeyboardInterrupt:
+            print("\ninterrupted: saving checkpoint...", flush=True)
+            self.checkpoints.save_periodic(self.counters["total_steps"], **self._state())
+        finally:
+            vec.close()
+            logger.close()
+        return dict(self.counters)
+
+    def _print(self, s: dict[str, float]) -> None:
+        phase = self.cfg.curriculum.phases[self.curriculum.index].name
+        win = s.get("episode/win_rate")
+        draw = s.get("episode/draw_rate")
+        episode = f"win {win:.2f} draw {draw:.2f}" if win is not None else "no finished episodes"
+        print(
+            f"upd {self.counters['update']:6d} | step {self.counters['total_steps'] / 1e6:7.3f}M"
+            f" | {s['perf/steps_per_sec']:6.0f} sps | {phase} | {episode}"
+            f" | ent {s['train/entropy']:.2f} | kl {s['train/approx_kl']:.4f}"
+            f" | ev {s['train/explained_variance']:.2f}",
+            flush=True,
+        )
diff --git a/src/rl/vec_env.py b/src/rl/vec_env.py
new file mode 100644
index 0000000..b013326
--- /dev/null
+++ b/src/rl/vec_env.py
@@ -0,0 +1,213 @@
+"""Vectorised training environments.
+
+``EnvGroup`` runs several ``CTFTrainEnv`` and returns stacked arrays; it auto-resets
+finished episodes (the returned observation is then the first of the next episode).
+``SubprocVecEnv`` runs one group per worker process (spawn context, so it behaves the
+same on macOS, Windows and Linux); ``InProcessVecEnv`` is the same thing without
+processes, for debugging and tests. Workers never import torch.
+"""
+
+from __future__ import annotations
+
+import multiprocessing as mp
+import traceback
+from dataclasses import dataclass, field
+
+import numpy as np
+
+from ctf.config import CTFConfig
+from rl.config import RLConfig
+from rl.env_wrapper import CTFTrainEnv, EnvStep
+
+
+@dataclass
+class VecStep:
+    grid: np.ndarray  # (E, A, C, H, W)
+    vec: np.ndarray  # (E, A, V)
+    mask: np.ndarray  # (E, A, NUM_ACTIONS)
+    alive: np.ndarray  # (E, A)
+    role_index: np.ndarray  # (E, A)
+    critic_grid: np.ndarray  # (E, A, Cc, H, W)
+    critic_vec: np.ndarray  # (E, A, Vc)
+    rewards: np.ndarray  # (E, A)
+    dones: np.ndarray  # (E,)
+    infos: list[dict] = field(default_factory=list)  # summaries of episodes finished this step
+
+
+def _pack(steps: list[EnvStep], infos: list[dict]) -> VecStep:
+    return VecStep(
+        grid=np.stack([s.actor.grid for s in steps]),
+        vec=np.stack([s.actor.vec for s in steps]),
+        mask=np.stack([s.actor.mask for s in steps]),
+        alive=np.stack([s.actor.alive for s in steps]),
+        role_index=np.stack([s.actor.role_index for s in steps]),
+        critic_grid=np.stack([s.critic.grid for s in steps]),
+        critic_vec=np.stack([s.critic.vec for s in steps]),
+        rewards=np.stack([s.rewards for s in steps]),
+        dones=np.array([float(s.done) for s in steps]),
+        infos=infos,
+    )
+
+
+def _merge(parts: list[VecStep]) -> VecStep:
+    cat = lambda name: np.concatenate([getattr(p, name) for p in parts], axis=0)  # noqa: E731
+    return VecStep(
+        grid=cat("grid"), vec=cat("vec"), mask=cat("mask"), alive=cat("alive"),
+        role_index=cat("role_index"), critic_grid=cat("critic_grid"), critic_vec=cat("critic_vec"),
+        rewards=cat("rewards"), dones=cat("dones"),
+        infos=[info for p in parts for info in p.infos],
+    )
+
+
+class EnvGroup:
+    def __init__(self, cfg: RLConfig, base_env_config: CTFConfig, seeds: list[int]) -> None:
+        self.envs = [CTFTrainEnv(cfg, base_env_config, seed) for seed in seeds]
+
+    def reset(self) -> VecStep:
+        return _pack([env.reset() for env in self.envs], [])
+
+    def step(self, actions: np.ndarray) -> VecStep:
+        steps: list[EnvStep] = []
+        infos: list[dict] = []
+        for env, act in zip(self.envs, actions):
+            result = env.step(act)
+            if result.done:
+                infos.append(result.info)
+                fresh = env.reset()
+                result = EnvStep(fresh.actor, fresh.critic, result.rewards, True, result.info)
+            steps.append(result)
+        return _pack(steps, infos)
+
+    def set_phase(self, index: int) -> None:
+        for env in self.envs:
+            env.set_phase(index)
+
+    def set_scout_scale(self, scale: float) -> None:
+        for env in self.envs:
+            env.set_scout_scale(scale)
+
+
+def _split(items: list[int], parts: int) -> list[list[int]]:
+    size, extra = divmod(len(items), parts)
+    out, start = [], 0
+    for i in range(parts):
+        end = start + size + (1 if i < extra else 0)
+        out.append(items[start:end])
+        start = end
+    return out
+
+
+class InProcessVecEnv:
+    def __init__(self, cfg: RLConfig, base_env_config: CTFConfig, seed: int) -> None:
+        self.num_envs = cfg.rollout.num_envs
+        self.num_agents = base_env_config.agents_per_team
+        self._group = EnvGroup(cfg, base_env_config, [seed + i for i in range(self.num_envs)])
+
+    def reset(self) -> VecStep:
+        return self._group.reset()
+
+    def step(self, actions: np.ndarray) -> VecStep:
+        return self._group.step(actions)
+
+    def set_phase(self, index: int) -> None:
+        self._group.set_phase(index)
+
+    def set_scout_scale(self, scale: float) -> None:
+        self._group.set_scout_scale(scale)
+
+    def close(self) -> None:
+        pass
+
+
+def _worker_main(conn, cfg: RLConfig, base_env_config: CTFConfig, seeds: list[int]) -> None:
+    try:
+        group = EnvGroup(cfg, base_env_config, seeds)
+        while True:
+            command, payload = conn.recv()
+            if command == "reset":
+                conn.send(("ok", group.reset()))
+            elif command == "step":
+                conn.send(("ok", group.step(payload)))
+            elif command == "set_phase":
+                group.set_phase(payload)
+                conn.send(("ok", None))
+            elif command == "set_scout_scale":
+                group.set_scout_scale(payload)
+                conn.send(("ok", None))
+            elif command == "close":
+                break
+    except Exception:  # report the traceback to the parent instead of dying silently
+        conn.send(("error", traceback.format_exc()))
+    finally:
+        conn.close()
+
+
+class SubprocVecEnv:
+    def __init__(self, cfg: RLConfig, base_env_config: CTFConfig, seed: int) -> None:
+        self.num_envs = cfg.rollout.num_envs
+        self.num_agents = base_env_config.agents_per_team
+        ctx = mp.get_context("spawn")
+        env_ids = list(range(self.num_envs))
+        self._slices = _split(env_ids, cfg.rollout.num_workers)
+        self._conns, self._procs = [], []
+        for ids in self._slices:
+            parent, child = ctx.Pipe()
+            proc = ctx.Process(
+                target=_worker_main,
+                args=(child, cfg, base_env_config, [seed + i for i in ids]),
+                daemon=True,
+            )
+            proc.start()
+            child.close()
+            self._conns.append(parent)
+            self._procs.append(proc)
+
+    def _recv_all(self) -> list:
+        results = []
+        for conn in self._conns:
+            status, payload = conn.recv()
+            if status == "error":
+                self.close()
+                raise RuntimeError(f"environment worker crashed:\n{payload}")
+            results.append(payload)
+        return results
+
+    def reset(self) -> VecStep:
+        for conn in self._conns:
+            conn.send(("reset", None))
+        return _merge(self._recv_all())
+
+    def step(self, actions: np.ndarray) -> VecStep:
+        for conn, ids in zip(self._conns, self._slices):
+            conn.send(("step", actions[ids[0] : ids[-1] + 1]))
+        return _merge(self._recv_all())
+
+    def _broadcast(self, command: str, payload) -> None:
+        for conn in self._conns:
+            conn.send((command, payload))
+        self._recv_all()
+
+    def set_phase(self, index: int) -> None:
+        self._broadcast("set_phase", index)
+
+    def set_scout_scale(self, scale: float) -> None:
+        self._broadcast("set_scout_scale", float(scale))
+
+    def close(self) -> None:
+        for conn in self._conns:
+            try:
+                conn.send(("close", None))
+            except (BrokenPipeError, OSError):
+                pass
+        for proc in self._procs:
+            proc.join(timeout=5)
+            if proc.is_alive():
+                proc.terminate()
+        self._conns, self._procs = [], []
+
+
+def make_vec_env(cfg: RLConfig, base_env_config: CTFConfig, seed: int):
+    """``rollout.num_workers == 0`` runs in this process; otherwise one process per worker."""
+    if cfg.rollout.num_workers == 0:
+        return InProcessVecEnv(cfg, base_env_config, seed)
+    return SubprocVecEnv(cfg, base_env_config, seed)
